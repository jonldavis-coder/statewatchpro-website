# Copy to .env for local runs. Never commit real secrets.

DATABASE_URL=postgres://localhost:5432/statewatchpro
SESSION_SECRET=replace-with-a-long-random-string
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=https://app.statewatchpro.com
MARKETING_URL=https://statewatchpro.com
COOKIE_SECURE=false

# Sale price ids. Defaults in code match these live Verasail prices.
STRIPE_PRICE_TRIAL=price_1UcE1fFhnOoFBQrwd8cVFFG9
STRIPE_PRICE_TRIAL_REGULAR=price_1UcE1fFhnOoFBQrwOqISK7d5
STRIPE_PRICE_MONTHLY=price_1UcE1gFhnOoFBQrw2EFjpFps
STRIPE_PRICE_MONTHLY_REGULAR=price_1UcE1gFhnOoFBQrwrhZ3SrfE
STRIPE_PRICE_ANNUAL=price_1UcE1hFhnOoFBQrwdPReAMdZ
STRIPE_PRICE_ANNUAL_REGULAR=price_1UcE1iFhnOoFBQrw9OsvEnuh
STRIPE_PRICE_FOIA=price_1UcE1iFhnOoFBQrwKX1zsL4K
STRIPE_PRICE_FOIA_5PACK=price_1UcE1jFhnOoFBQrwgRAVQyAN

# Leave SMTP_HOST empty to log mail, including password-reset links, to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StateWatchPro <hello@statewatchpro.com>
